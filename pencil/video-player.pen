              "type": "text",
              "id": "X1uzCh",
              "name": "Note 6",
              "fill": "#3a2e28",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "6. \"Add from URL here…\" on a Video folder in the Library opens this with Video already chosen.",
              "lineHeight": 1.45,
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            }
